{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'Skip build — F17 CURRENT -> Phase S -> F5 -> WA4 -> WA3 -> WA2 -> F4'"
  },
  "deploy": {
    "startCommand": "env NODE_OPTIONS='--require ./sentinel-sentry-init.cjs' node server-f17-current.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  },
  "environments": {
    "staging-sales-intelligence": {
      "deploy": {
        "startCommand": "node staging-server.js",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}

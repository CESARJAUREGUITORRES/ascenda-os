{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'Skip build — K1 CURRENT chain: server-k1.js -> server-phase-s.js -> server-f5.js -> server-wa4.js -> server-wa3.js -> server-wa2.js -> server-f4.js'"
  },
  "deploy": {
    "startCommand": "env NODE_OPTIONS='--require ./sentinel-sentry-init.cjs' node server-k1.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  },
  "environments": {
    "staging-sales-intelligence": {
      "deploy": {
        "startCommand": "node staging-server.js",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}

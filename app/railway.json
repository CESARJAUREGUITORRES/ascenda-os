{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'Skip build — certified outer runtime chain: node server-wa3.js -> node server-wa2.js -> node server-f4.js'"
  },
  "deploy": {
    "startCommand": "node server-wa3.js",
    "restartPolicyType": "ON_FAILURE"
  },
  "environments": {
    "staging-sales-intelligence": {
      "deploy": {
        "startCommand": "node staging-server.js",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}

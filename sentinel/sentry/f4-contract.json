  "sampling": {
    "traces_sample_rate": 0,
    "logs": 0,
    "replays": 0,
    "metrics": 0
  },
  "allowed_tags": [
    "system",
    "sentinel.phase",
    "sentinel.domain",
    "sentinel.component",
    "sentinel.capability",
    "sentinel.dependency",
    "service.name"
